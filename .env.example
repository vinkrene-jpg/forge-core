# ── Forge Core environment configuration ─────────────────────────────
# Copy this file to .env and fill in your values.
# Forge Core has no hard dependency on any hosting platform: everything
# is configured here.

# Database (PostgreSQL, required)
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Storage directory for sandboxes, snapshots and backups
# (created automatically if missing)
STORAGE_DIR=./storage

# Session secret (any random string)
SESSION_SECRET=change-me

# ── AI Gateway providers ─────────────────────────────────────────────
# All AI calls run through the central gateway. Configure at least one
# provider to enable AI features. Without a key, the platform still
# works — AI invocations return a clear error.

# OpenAI (or any OpenAI-compatible endpoint)
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Custom / local (e.g. Ollama) — OpenAI-compatible
#CUSTOM_AI_API_KEY=ollama
#CUSTOM_AI_BASE_URL=http://localhost:11434/v1
#CUSTOM_AI_MODEL=llama3

# Default and fallback provider (openai | anthropic | custom)
AI_DEFAULT_PROVIDER=openai
#AI_FALLBACK_PROVIDER=anthropic

# Task-type routing: route specific task types to specific providers.
#AI_ROUTE_PLANNING=openai
#AI_ROUTE_ARCHITECTURE=anthropic
#AI_ROUTE_CODEGENERATION=openai
#AI_ROUTE_TESTING=openai
#AI_ROUTE_SECURITYREVIEW=anthropic
#AI_ROUTE_DOCUMENTATION=openai
#AI_ROUTE_SUMMARY=openai
#AI_ROUTE_ERRORANALYSIS=openai

# ── Real Test Runner ─────────────────────────────────────────────────
# Comma-separated env var names that MAY be passed to sandboxed test
# processes. Core credentials (DATABASE_URL, SESSION_SECRET, PG*, AI
# keys) are always refused. Sensitive-looking names (SECRET/TOKEN/KEY/
# PASSWORD/...) are only allowed with a TEST_ prefix.
#TEST_SECRET_ALLOWLIST=TEST_API_TOKEN,SOME_FLAG

# Per-step timeout for real test execution in milliseconds.
# Default: 180000 (install), 120000 (other steps).
#REAL_TEST_STEP_TIMEOUT_MS=120000

# ── Governance ───────────────────────────────────────────────────────
# Locked Core override. Leave unset in normal operation: locked core
# components can then never be modified. Set to "true" only as owner
# for deliberate maintenance.
#CORE_ADMIN_OVERRIDE=false

# ── Mission Guardian / Governor ──────────────────────────────────────
# Every completed mission is reviewed by Guardian and released by
# Governor before its result is published. By default this review is
# deterministic and rule-based (no provider needed). Set to "true" to
# additionally run the specialised AI Guardian through the AI Gateway:
# the AI verdict can only make the outcome stricter, never milder, and
# if no provider is configured or the call fails, the review falls back
# to the rule-based verdict — the mission chain is never blocked merely
# because the AI is unavailable.
#FORGE_MISSION_AI_REVIEW_ENABLED=false

# ── Incoming folder intake ───────────────────────────────────────────
# When enabled, files dropped into the incoming directory are picked up
# automatically and recorded as inert Claude Mirror intake missions
# (never executed without governance). Processed files move to
# <dir>/processed; rejected files move to <dir>/failed with a sibling
# .error.txt. The directory is fully configurable, so it can live on a
# roomier drive or a NAS instead of the system drive.
#FORGE_INCOMING_ENABLED=false
#FORGE_INCOMING_DIR=C:\Forge\incoming
# Optional overrides (default: <dir>\processed and <dir>\failed)
#FORGE_INCOMING_PROCESSED_DIR=D:\Forge\incoming-processed
#FORGE_INCOMING_FAILED_DIR=D:\Forge\incoming-failed
# Poll interval in milliseconds (default 5000, minimum 500)
#FORGE_INCOMING_POLL_MS=5000

# A dropped .json file is read as a Mirror intake body (requestId, title,
# objective, priority, ...); any other file (.txt/.md) is treated as a
# plain-text objective. Missing identity fields default from the file
# name, so re-dropping the same file is idempotent.
